{
  "name": "ChatMessage",
  "properties": {
    "album_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_listed": {
      "default": false,
      "description": "True only when the parent album is public and has no password. Controls who may read this message.",
      "type": "boolean"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "album_id",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_listed": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}