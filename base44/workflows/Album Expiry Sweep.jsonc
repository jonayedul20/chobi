{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "album_expiry_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep_expired_albums": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "archiveExpiredAlbums",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Archive expired albums",
            "description": "Every 30 minutes"
          }
        }
      }
    ]
  },
  "name": "Album Expiry Sweep",
  "description": "Automatically marks albums as expired when their expiration time passes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}